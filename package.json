{
  "name": "obsidian-heypocket-importer",
  "version": "1.0.0",
  "description": "Import HeyPocket (Pocket AI) recordings into an Obsidian vault as Markdown notes via the public API, JSON exports, or ZIP archives.",
  "private": true,
  "main": "main.js",
  "keywords": [
    "obsidian",
    "heypocket",
    "pocket-ai",
    "transcription",
    "importer"
  ],
  "license": "MIT",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "typecheck": "tsc -noEmit -skipLibCheck",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "dependencies": {
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "builtin-modules": "^5.0.0",
    "esbuild": "^0.25.0",
    "obsidian": "^1.8.0",
    "tslib": "2.8.1",
    "typescript": "^5.8.0"
  }
}
